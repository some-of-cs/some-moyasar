# Moyasar API Credentials for Integration & Live E2E Testing
# Copy this file to `.env` or `.env.local` in the repository root:
#   cp .env.example .env
#
# `some-moyasar` (`env-keys` feature) automatically resolves `$MOYASAR_SECRET_KEY`
# and `$MOYASAR_PUBLISHABLE_KEY` from process environment variables or `.env.local` -> `.env`.
# When a real key is placed in `.env`, `cargo test --tests --all-features` will use it
# automatically in `tests/dotenv_live_integration.rs`.

MOYASAR_SECRET_KEY=sk_test_replace_with_your_real_secret_key
MOYASAR_PUBLISHABLE_KEY=pk_test_replace_with_your_real_publishable_key
MOYASAR_WEBHOOK_SECRET=whsec_replace_with_your_webhook_shared_secret

# Optional: set to 0 to skip live https://api.moyasar.com calls even when .env has a real key
MOYASAR_RUN_LIVE_TESTS=1
